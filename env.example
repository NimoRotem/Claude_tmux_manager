# Required: OpenAI API key for LLM-powered summaries
OPENAI_API_KEY=sk-proj-your-key-here

# Server settings
VIBE_PORT=8501
VIBE_DOMAIN=dianao.tech

# Fixed secret for cookie signing (auto-generated if not set,
# but sessions will invalidate on restart)
# VIBE_SECRET=some-random-hex-string

# Base directories
VIBE_USERS_DIR=/var/vibe-coder/users
VIBE_DATA_DIR=/var/vibe-coder/data

# Command to auto-run in new tmux sessions
VIBE_NEW_SESSION_CMD=claude --dangerously-skip-permissions
