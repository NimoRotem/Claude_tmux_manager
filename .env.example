# Required: OpenAI API key for LLM-powered summaries
OPENAI_API_KEY=sk-proj-your-key-here

# Auth credentials (login page)
TMUX_DASH_USER=admin
TMUX_DASH_PASS=changeme

# Optional: fixed secret for cookie signing (auto-generated if not set,
# but sessions will invalidate on restart)
# TMUX_DASH_SECRET=some-random-hex-string

# Server settings
TMUX_DASH_PORT=8501
TMUX_DASH_ROOT_PATH=/tmux

# Command to auto-run when creating a new tmux session (leave empty to skip)
# TMUX_DASH_NEW_SESSION_CMD=claude
